# ================================================================
# MailCommandBot 配置文件
# ================================================================

# ==================== 接收模式配置 ====================
# 邮件接收模式: smtp(自建服务器) / pop3 / imap / imap_server(自建IMAP)
RECEIVE_MODE=smtp

# ==================== IMAP 自建服务器配置 ====================
# IMAP 服务器绑定地址
IMAP_BIND_HOST=0.0.0.0
# IMAP 服务器绑定端口
IMAP_BIND_PORT=993

# ==================== 已有邮件服务器配置（pop3/imap 模式） ====================
# 收件服务器地址（如 pop.qq.com / imap.qq.com）
MAIL_IN_HOST=
# 收件协议: pop3 / imap
MAIL_IN_PROTOCOL=
# 是否启用 TLS/SSL
MAIL_IN_TLS=
# 收件服务器端口（留空则根据协议和 TLS 自动选择: pop3=995/110, imap=993/143）
MAIL_IN_PORT=
# 收件邮箱账号
MAIL_IN_USER=
# 收件邮箱密码/授权码
MAIL_IN_PASS=
# 轮询检查间隔（秒）
MAIL_POLL_INTERVAL=
# IMAP 收件箱文件夹名
MAIL_INBOX_FOLDER=

# ==================== 邮件发送配置（所有模式共用） ====================
# 外发SMTP服务器
SMTP_OUT_HOST=
SMTP_OUT_PORT=
SMTP_OUT_TIMEOUT=
# 发件邮箱账号
SMTP_OUT_USER=
# 发件邮箱授权码/密码
SMTP_OUT_PASS=
# 外发SMTP是否启用TLS
SMTP_OUT_TLS=
# 发件人显示名称
SENDER_NAME=

# ==================== 安全白名单配置 ====================
# 允许触发命令执行的发件人邮箱（逗号分隔，留空表示不限制）
ALLOWED_SENDERS=
# 允许的邮箱域名（逗号分隔，留空表示不限制）
ALLOWED_DOMAINS=
# 允许连接SMTP接收服务器的客户端IP（逗号分隔，留空不限制，仅smtp模式生效）
ALLOWED_CLIENT_IPS=
# 未配置白名单时是否强制绑定 127.0.0.1
REQUIRE_WHITELIST=true

# ==================== 安全限制开关 ====================
# 是否启用命令白名单（false=允许所有命令，true=仅允许白名单中的命令）
CMD_WHITELIST_ENABLE=true
# 是否检查危险字符（false=不检查，true=拦截包含管道/重定向等字符的命令）
CMD_BLOCK_META_ENABLE=true
# 是否启用发件人白名单（false=允许所有发件人，true=仅允许白名单中的邮箱）
SENDER_WHITELIST_ENABLE=true
# 是否启用频率限制（false=不限制，true=限制每分钟最多 RATE_LIMIT_PER_MINUTE 封）
RATE_LIMIT_ENABLE=true

# ==================== sudo 配置 ====================
# 是否使用 sudoers NOPASSWD 模式（建议启用，避免邮件传输密码）
SUDO_NOPASSWD=false

# ==================== 频率限制配置 ====================
# 每个发件人每分钟最多发送的命令邮件数
RATE_LIMIT_PER_MINUTE=10

# ==================== 命令执行配置 ====================
# 命令执行超时（秒）
CMD_TIMEOUT=30
# 命令输出最大长度（字符）
CMD_MAX_OUTPUT=50000

# ==================== 邮件大小限制 ====================
# 单封邮件最大字节数（默认1MB）
MAX_EMAIL_SIZE=1048576

# ==================== SMTP 连接保活配置 ====================
# SMTP 外发连接心跳保活间隔（秒），0 禁用
SMTP_KEEPALIVE_INTERVAL=60

# ==================== 自动更新配置 ====================
# GitHub仓库地址（用于自动更新，格式: owner/repo）
GITHUB_REPO=diaoyunxi/mail-command-server
# GitHub Token（用于私有仓库和提升API速率限制）
GITHUB_TOKEN=
# 更新检查分支
UPDATE_BRANCH=main
# 启动时是否检查更新
CHECK_UPDATE_ON_START=true
# 最大自动重启次数（防止无限重启循环）
MAX_RESTART_COUNT=5

# ==================== 日志配置 ====================
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# 日志文件路径
LOG_FILE=mail_command_bot.log
# 日志文件最大大小（字节，默认10MB）
LOG_MAX_BYTES=10485760
# 日志备份文件数量
LOG_BACKUP_COUNT=5
