# 邮件命令服务器配置模板

# SMTP 配置
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password
# SMTP_TLS=true

# POP3 配置
# POP3_HOST=pop.example.com
# POP3_PORT=995
# POP3_USER=your_email@example.com
# POP3_PASS=your_password

# 命令执行配置
# CMD_WHITELIST_ENABLE=true
# CMD_BLOCK_META_ENABLE=true
